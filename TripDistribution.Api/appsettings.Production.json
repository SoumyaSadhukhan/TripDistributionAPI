{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "tripdistribution.com;app.tripdistribution.com",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SPLIT_BILL_DB;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=False;"
  },
  "JwtSettings": {
    "SecretKey": "CONFIGURED_VIA_ENVIRONMENT_OR_KEY_VAULT",
    "Issuer": "TripDistribution.Api",
    "Audience": "TripDistribution.Client",
    "ExpiryInMinutes": 1440,
    "RefreshTokenExpiryInDays": 30
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://tripdistribution.com",
      "https://app.tripdistribution.com"
    ]
  },
  "AuthSettings": {
    "ExposeOtpInResponse": false,
    "BypassOtpInDebug": false
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "AuthLimit": 30
  },
  "ApiKeySettings": {
    "HeaderName": "X-Api-Key",
    "SecretKey": "CONFIGURED_VIA_ENVIRONMENT_OR_KEY_VAULT"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "notifications@tripdistribution.com",
    "Password": "CONFIGURED_VIA_ENVIRONMENT_OR_KEY_VAULT",
    "SmtpPassword": "CONFIGURED_VIA_ENVIRONMENT_OR_KEY_VAULT",
    "FromEmail": "notifications@tripdistribution.com",
    "FromName": "EquiTrip"
  }
}
